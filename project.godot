;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Scarf Rise"
config/version="0.0.1"
run/main_scene="res://scenes/menu_inicio.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/image="uid://d1ex40acfoua7"
config/icon="res://icon.svg"

[autoload]

DialogueManager="*uid://c3rodes2l3gxb"
ColorSystem="*uid://6a1elklasvz4u"

[dialogue_manager]

runtime/balloon_path="res://dialogues/balloon.tscn"

[display]

window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg")

